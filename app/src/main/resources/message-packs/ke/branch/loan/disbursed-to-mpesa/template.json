      "pattern": "(?:Your loan of[ ]+)?(?:(?:KES|Kshs?|Ksh)[.]?|Kenya[ ]+Shillings?)[ ]*([0-9,]+(?:[.][0-9]{1,2})?)[ ]+has been[ ]+(?:transferred|disbursed)[ ]+to your M-Pesa account",
      "group": 1,
      "required": true
    },
    {
      "field": "REPAY_AMOUNT",
      "pattern": "Repay[ ]+(?:KES|Kshs?|Ksh)[.]?[ ]*([0-9,]+(?:[.][0-9]{1,2})?)",
      "group": 1
    },
    {
      "field": "DATE",
      "pattern": "Repay[ ]+(?:KES|Kshs?|Ksh)[.]?[ ]*[0-9,]+(?:[.][0-9]{1,2})?[ ]+by[ ]+(.+?)[ ]+to grow your limit",
      "group": 1
    }
  ]
