{
  "id": "ke.sanlam.investment.fund-credit",
  "revision": 1,
  "country": "KE",
  "senderIds": ["SANLAM_UT", "SANLAM UT", "SANLAM"],
  "requiredAnchors": ["Money Market Fund has been credited with", " units"],
  "anyAnchors": ["as of"],
  "eventKind": "INVESTMENT_CREDIT",
  "productIdentity": "KENYAN_INVESTMENT_SANLAM",
  "active": true,
  "extractors": [
    {
      "field": "AMOUNT",
      "pattern": "credited with[ ]+(?:(?:KES|Kes|Kshs?[.]?)[ ]*)?([0-9,]+(?:[.][0-9]{1,2})?)[ ]+and",
      "group": 1,
      "required": true
    },
    {
      "field": "PRODUCT",
      "pattern": "account for[ ]+(.+?)[ ]+has been credited",
      "group": 1
    },
    {
      "field": "UNITS",
      "pattern": "[ ]and[ ]+([0-9,]+(?:[.][0-9]+)?)[ ]+units",
      "group": 1
    },
    {
      "field": "DATE",
      "pattern": "as of[ ]+([^.]*)[.]",
      "group": 1
    }
  ]
}
