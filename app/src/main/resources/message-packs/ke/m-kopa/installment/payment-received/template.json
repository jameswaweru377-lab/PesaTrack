{
  "id": "ke.m-kopa.installment.payment-received",
  "revision": 1,
  "country": "KE",
  "senderIds": ["M-KOPA", "MKOPA"],
  "requiredAnchors": ["Received", "for account", "device is unlocked until", "Outstanding balance"],
  "anyAnchors": [],
  "eventKind": "INSTALLMENT_PAYMENT_RECEIPT",
  "productIdentity": "M_KOPA_FINANCING",
  "active": true,
  "extractors": [
    {
      "field": "AMOUNT",
      "pattern": "Received[ ]+(?:KES|Kshs?|Ksh)[.]?[ ]*([0-9,]+(?:[.][0-9]{1,2})?)[ ]+for account",
      "group": 1,
      "required": true
    },
    {
      "field": "ACCOUNT_REFERENCE",
      "pattern": "for account[ ]+([A-Z0-9*.-]+)",
      "group": 1
    },
    {
      "field": "DATE",
      "pattern": "device is unlocked until[ ]+(.+?)[ ]+[0-9]{1,2}:[0-9]{2}",
      "group": 1
    },
    {
      "field": "TIME",
      "pattern": "device is unlocked until[ ]+.+?[ ]+([0-9]{1,2}:[0-9]{2}(?:[ ]*[AP]M)?)",
      "group": 1
    },
    {
      "field": "BALANCE",
      "pattern": "Outstanding balance is[ ]+(?:KES|Kshs?|Ksh)[.]?[ ]*([0-9,]+(?:[.][0-9]{1,2})?)",
      "group": 1
    }
  ]
}
