    {"field":"BALANCE","pattern":"(?:New[ ]+)?M-PESA(?:[ ]+account)?[ ]+balance[ ]+is[ ]+(?:Ksh|KES)[ ]*([0-9,]+(?:[.][0-9]{1,2})?)","group":1}
  ]
}
