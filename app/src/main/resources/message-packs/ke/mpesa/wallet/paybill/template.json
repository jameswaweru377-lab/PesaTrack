{
  "id": "ke.mpesa.wallet.paybill",
  "revision": 1,
  "country": "KE",
  "senderIds": ["MPESA"],
  "requiredAnchors": ["Confirmed.", " paid to ", " for account ", "M-PESA balance"],
  "anyAnchors": [],
  "eventKind": "PAYMENT",
  "productIdentity": "SAFARICOM_MPESA",
  "active": true,
  "extractors": [
    {"field":"TRANSACTION_CODE","pattern":"^([A-Z0-9]{10})[ ]+Confirmed[.]","group":1,"required":true},
    {"field":"AMOUNT","pattern":"(?:Ksh|KES)[ ]*([0-9,]+(?:[.][0-9]{1,2})?)[ ]+paid to","group":1,"required":true},
    {"field":"COUNTERPARTY","pattern":"paid to[ ]+(.+?)[ ]+for account","group":1,"required":true},
    {"field":"ACCOUNT_REFERENCE","pattern":"for account[ ]+(.+?)[ ]+on[ ]+[0-9]","group":1},
    {"field":"BALANCE","pattern":"(?:New[ ]+)?M-PESA[ ]+balance[ ]+is[ ]+(?:Ksh|KES)[ ]*([0-9,]+(?:[.][0-9]{1,2})?)","group":1},
    {"field":"FEE","pattern":"Transaction[ ]+(?:cost|fee)[,:]?[ ]*(?:Ksh|KES)[ ]*([0-9,]+(?:[.][0-9]{1,2})?)","group":1}
  ]
}
