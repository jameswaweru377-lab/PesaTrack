{
  "id": "ke.globalpay.card.purchase",
  "revision": 1,
  "country": "KE",
  "senderIds": ["GLOBALPAY", "GLOBAL PAY"],
  "requiredAnchors": ["transaction of", " has been approved"],
  "anyAnchors": ["inclusive of", "done at"],
  "eventKind": "PAYMENT",
  "productIdentity": "KENYAN_PAYMENT_GLOBALPAY",
  "active": true,
  "extractors": [
    {
      "field": "AMOUNT",
      "pattern": "transaction of[ ]+(?:(?:Ksh[.]?|KES)[ ]*)?([0-9,]+(?:[.][0-9]{1,2})?)[ ]*[(]inclusive",
      "group": 1,
      "required": true
    },
    {
      "field": "FEE",
      "pattern": "inclusive of[ ]+(?:(?:Ksh[.]?|KES)[ ]*)?([0-9,]+(?:[.][0-9]{1,2})?)[ ]+forex",
      "group": 1
    },
    {
      "field": "COUNTERPARTY",
      "pattern": "done at[ ]+(.+?)[ ]+has been approved",
      "group": 1,
      "required": true
    }
  ]
}
