{
  "id": "ke.mshwari.loan.full-repayment-overpayment",
  "revision": 1,
  "country": "KE",
  "senderIds": [
    "MPESA"
  ],
  "requiredAnchors": [
    "Loan of",
    "repaid from",
    "Your loan is repaid in full"
  ],
  "anyAnchors": [
    "overpayment",
    "Savings Account",
    "M-Shwari balance"
  ],
  "eventKind": "DEBT_REPAYMENT",
  "productIdentity": "NCBA_MSHWARI_LOAN",
  "active": true,
  "extractors": [
    {
      "field": "TRANSACTION_CODE",
      "pattern": "^([A-Z0-9]{10})[ ]+Confirmed[.]",
      "group": 1
    },
    {
      "field": "AMOUNT",
      "pattern": "Loan of[ ]+(?:Kshs?|KES|Sh)[.]?[ ]*([0-9,]+(?:[.][0-9]{1,2})?)[ ]+repaid from",
      "group": 1,
      "required": true
    },
    {
      "field": "SOURCE",
      "pattern": "repaid from[ ]+(?:your[ ]+)?(M-PESA)",
      "group": 1,
      "required": true
    },
    {
      "field": "DATE",
      "pattern": "repaid from[ ]+(?:your[ ]+)?M-PESA[ ]+account[ ]+on[ ]+([0-9]{1,2}/[0-9]{1,2}/[0-9]{2,4}[ ]+at[ ]+[0-9]{1,2}:[0-9]{2}(?::[0-9]{2})?[ ]*(?:AM|PM))",
      "group": 1
    },
    {
      "field": "FEE",
      "pattern": "Transaction cost[ ]*[,.:]?[ ]*(?:Kshs?|KES|Sh)[.]?[ ]*([0-9,]+(?:[.][0-9]{1,2})?)",
      "group": 1
    }
  ]
}
