{
  "id": "ke.mshwari.loan.full-repayment-overpayment",
  "revision": 1,
  "country": "KE",
  "senderIds": [
    "MPESA"
  ],
  "requiredAnchors": [
    "Loan of",
    "repaid from your M-PESA account",
    "loan is repaid in full",
    "New M-Shwari balance is"
  ],
  "anyAnchors": [
    "overpayment has been moved",
    "overpayment has been transferred"
  ],
  "eventKind": "DEBT_REPAYMENT",
  "productIdentity": "NCBA_MSHWARI_LOAN",
  "active": true,
  "extractors": [
    {
      "field": "TRANSACTION_CODE",
      "pattern": "^([A-Z0-9]{10})[ ]+Confirmed[.]",
      "group": 1,
      "required": true
    },
    {
      "field": "AMOUNT",
      "pattern": "Loan of[ ]+(?:Kshs?|KES|Sh)[.]?[ ]*([0-9,]+(?:[.][0-9]{1,2})?)[ ]+repaid from",
      "group": 1,
      "required": true
    },
    {
      "field": "SOURCE",
      "pattern": "repaid from your[ ]+(M-PESA)[ ]+account",
      "group": 1,
      "required": true
    },
    {
      "field": "DATE",
      "pattern": "repaid from your[ ]+M-PESA[ ]+account[ ]+on[ ]+([0-9]{1,2}/[0-9]{1,2}/[0-9]{2,4}[ ]+at[ ]+[0-9]{1,2}:[0-9]{2}(?::[0-9]{2})?[ ]*(?:AM|PM))",
      "group": 1,
      "required": true
    },
    {
      "field": "COMPLETION",
      "pattern": "(loan[ ]+is[ ]+repaid[ ]+in[ ]+full)",
      "group": 1,
      "required": true
    },
    {
      "field": "SAVINGS_BALANCE",
      "pattern": "New[ ]+M-Shwari[ ]+balance[ ]+is[ ]+(?:Kshs?|KES|Sh)[.]?[ ]*([0-9,]+(?:[.][0-9]{1,2})?)",
      "group": 1,
      "required": true
    },
    {
      "field": "WALLET_BALANCE",
      "pattern": "M-PESA[ ]+balance[ ]+is[ ]+(?:Kshs?|KES|Sh)[.]?[ ]*([0-9,]+(?:[.][0-9]{1,2})?)",
      "group": 1
    },
    {
      "field": "FEE",
      "pattern": "Transaction[ ]+cost[ ]*[,.:]?[ ]*(?:Kshs?|KES|Sh)[.]?[ ]*([0-9,]+(?:[.][0-9]{1,2})?)",
      "group": 1
    }
  ]
}
