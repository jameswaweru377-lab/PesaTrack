  "revision": 1,
  "country": "KE",
  "senderIds": ["EVOPAY", "EVO PAY"],
  "requiredAnchors": ["parking fee has been charged to your card", "Your new card balance"],
  "anyAnchors": ["Thank you for visiting"],
