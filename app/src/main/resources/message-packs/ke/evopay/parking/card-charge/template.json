      "group": 1,
      "required": true
    },
    {
      "field": "BALANCE",
      "pattern": "new card balance is[ ]+(?:(?:Ksh[.]?|KES)[ ]*)?([0-9,]+(?:[.][0-9]{1,2})?)",
      "group": 1
    },
    {
      "field": "COUNTERPARTY",
      "pattern": "Thank you for visiting[ ]+(.+?)[.]?$",
      "group": 1,
      "required": true
    }
  ]
}
