{
  "id": "ke.equity.account.credit",
  "revision": 1,
  "country": "KE",
  "senderIds": [
    "EQUITY",
    "EQUITY BANK"
  ],
  "requiredAnchors": [
    "Your Equity a/c",
    "has been credited with",
    "Bal",
    "Ref"
  ],
  "anyAnchors": [],
  "eventKind": "ACCOUNT_CREDIT",
  "productIdentity": "KENYAN_BANK_EQUITY",
  "active": true,
  "extractors": [
    {
      "field": "ACCOUNT_REFERENCE",
      "pattern": "Equity[ ]+a/c[ ]+([A-Z0-9*X-]+)[ ]+has been credited",
      "group": 1,
      "required": true
    },
    {
      "field": "AMOUNT",
      "pattern": "credited with[ ]+(?:(?:KES|Kshs?[.]?|Sh)[ ]*)?([0-9,]+(?:[.][0-9]{1,2})?)[ ]+on[ ]+",
      "group": 1,
      "required": true
    },
    {
      "field": "DATE",
      "pattern": "[ ]on[ ]+([0-9]{1,2}/[0-9]{1,2}/[0-9]{2,4})",
      "group": 1
    },
    {
      "field": "BALANCE",
      "pattern": "Bal[: ]*[ ]*(?:(?:KES|Kshs?[.]?|Sh)[ ]*)?([0-9,]+(?:[.][0-9]{1,2})?)",
      "group": 1
    },
    {
      "field": "REFERENCE",
      "pattern": "Ref[: ]+[ ]*([A-Z0-9-]+)",
      "group": 1
    }
  ]
}
