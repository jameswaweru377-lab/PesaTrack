{
  "id": "ke.equity.transfer.credit-to-beneficiary",
  "revision": 1,
  "country": "KE",
  "senderIds": [
    "EQUITY",
    "EQUITY BANK",
    "EQUITY BULK"
  ],
  "requiredAnchors": [
    "Your transaction of",
    "has been credited to"
  ],
  "anyAnchors": [
    "MPESA Ref",
    "M-Pesa Ref",
    "M-Pesa Ref.",
    "MPESA Ref."
  ],
  "eventKind": "PAYMENT",
  "productIdentity": "KENYAN_BANK_EQUITY",
  "active": true,
  "extractors": [
    {
      "field": "AMOUNT",
      "pattern": "Your transaction of[ ]+(?:(?:Kshs?[.]?|KES|Kenya Shillings?)[ ]*)([0-9,]+(?:[.][0-9]{1,2})?)[ ]+has been credited to",
      "group": 1,
      "required": true
    },
    {
      "field": "COUNTERPARTY",
      "pattern": "has been credited to[ ]+(?:(?:[+]?(?:254|0)[0-9]{9,12})[ ]+)?(.+?)(?=[.][ ]*(?:Equity[ ]+)?Ref|[ ]+(?:Equity[ ]+)?Ref)",
      "group": 1,
      "required": true
    },
    {
      "field": "BANK_REFERENCE",
      "pattern": "(?:Equity[ ]+)?Ref[.]?[ ]*([A-Z0-9-]{5,32})",
      "group": 1
    },
    {
      "field": "EXTERNAL_REFERENCE",
      "pattern": "M-?PESA[ ]+Ref[.]?[ ]*([A-Z0-9-]{5,32})",
      "group": 1,
      "required": true
    },
    {
      "field": "DATE_TIME",
      "pattern": "on[ ]+([0-9]{1,2}[/\\-][0-9]{1,2}[/\\-][0-9]{2,4}[ ]+at[ ]+[0-9]{1,2}:[0-9]{2}(?::[0-9]{2})?)",
      "group": 1
    }
  ]
}
