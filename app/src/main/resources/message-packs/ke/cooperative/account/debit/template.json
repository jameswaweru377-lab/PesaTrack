{
  "id": "ke.cooperative.account.debit",
  "revision": 1,
  "country": "KE",
  "senderIds": [
    "CO-OP BANK",
    "COOP BANK",
    "COOPERATIVE BANK"
  ],
  "requiredAnchors": [
    "A/C",
    " DR ",
    "KES",
    " Bal ",
    " Ref"
  ],
  "anyAnchors": [],
  "eventKind": "ACCOUNT_DEBIT",
  "productIdentity": "KENYAN_BANK_COOPERATIVE",
  "active": true,
  "extractors": [
    {
      "field": "ACCOUNT_REFERENCE",
      "pattern": "A/C[ ]+([A-Z0-9*X-]+)[ ]+DR[ ]+",
      "group": 1,
      "required": true
    },
    {
      "field": "AMOUNT",
      "pattern": "[ ]DR[ ]+(?:(?:KES|Kshs?[.]?|Sh)[ ]*)?([0-9,]+(?:[.][0-9]{1,2})?)[ ]+on[ ]+",
      "group": 1,
      "required": true
    },
    {
      "field": "DATE",
      "pattern": "[ ]on[ ]+([0-9]{1,2}/[0-9]{1,2}/[0-9]{2,4})",
      "group": 1
    },
    {
      "field": "BALANCE",
      "pattern": "Bal[: ]*[ ]*(?:(?:KES|Kshs?[.]?|Sh)[ ]*)?([0-9,]+(?:[.][0-9]{1,2})?)",
      "group": 1
    },
    {
      "field": "REFERENCE",
      "pattern": "Ref[: ]+[ ]*([A-Z0-9-]+)",
      "group": 1
    }
  ]
}
