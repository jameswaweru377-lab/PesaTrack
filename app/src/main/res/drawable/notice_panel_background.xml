<?xml version="1.0" encoding="utf-8"?>
<!-- Stable, accessible light canvas even when HyperOS forces dark notification
     surfaces while PesaTrack is configured in light mode. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/notice_card" />
    <stroke android:width="1dp" android:color="@color/notice_outline" />
    <corners android:radius="14dp" />
</shape>
