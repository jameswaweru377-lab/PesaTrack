<?xml version="1.0" encoding="utf-8"?>
<!-- Rich expansion of the approved mock-up; the OS retains the outer card. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <TextView
        android:layout_width="3dp"
        android:layout_height="match_parent"
        android:background="@color/notice_purple" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="9dp"
        android:paddingTop="9dp"
        android:paddingBottom="9dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/notice_badge"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:background="@drawable/notice_badge_background"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="@color/notice_purple"
            android:textSize="12sp"
            android:textStyle="bold"
            android:singleLine="true" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/notice_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/notice_text"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:maxLines="2"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/notice_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:textColor="@color/notice_secondary"
                    android:textSize="14sp"
                    android:maxLines="2"
                    android:ellipsize="end" />
            </LinearLayout>

            <ImageView
                android:id="@+id/notice_category_icon"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginStart="10dp"
                android:padding="13dp"
                android:background="@drawable/notice_icon_background"
                android:contentDescription="@null" />
        </LinearLayout>

        <TextView
            android:id="@+id/notice_action"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_marginTop="5dp"
            android:gravity="center_vertical"
            android:textColor="@color/notice_purple"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
