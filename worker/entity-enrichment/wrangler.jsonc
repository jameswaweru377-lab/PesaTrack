{
  "name": "pesatrack",
  "main": "src/index.js",
  "compatibility_date": "2026-09-29",
  "workers_dev": true,
  "keep_vars": true,
  "ratelimits": [
    {
      "name": "ENTITY_RESOLVE_CLIENT_RATE_LIMITER",
      "namespace_id": "26090401",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    {
      "name": "ENTITY_RESOLVE_IP_RATE_LIMITER",
      "namespace_id": "26090403",
      "simple": {
        "limit": 300,
        "period": 60
      }
    },
    {
      "name": "ENTITY_RESOLVE_EDGE_RATE_LIMITER",
      "namespace_id": "26090402",
      "simple": {
        "limit": 600,
        "period": 60
      }
    }
  ]
}
